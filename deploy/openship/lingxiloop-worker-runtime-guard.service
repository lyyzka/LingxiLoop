[Unit]
Description=LingxiLoop App B Worker runtime guard
Documentation=https://github.com/lyyzka/LingxiLoop/tree/main/deploy/openship
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/lingxiloop-worker-runtime-guard --watch
Restart=always
RestartSec=2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
