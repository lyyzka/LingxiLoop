{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-control-plane-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lingxiloop-control-plane-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ORIGIN_BASE_URL": "https://origin.example.com",
    "UPTIME_BASE_URL": "https://uptime.example.com",
    "ARCANE_BASE_URL": "https://ops.example.com",
    "ARCANE_TARGETS_JSON": "{\"lingxiloop-core-state\":{\"environmentId\":\"a\",\"projectId\":\"core\"},\"lingxiloop-app-a\":{\"environmentId\":\"a\",\"projectId\":\"app-a\"},\"server-b-ingress\":{\"environmentId\":\"b\",\"projectId\":\"ingress\"},\"lingxiloop-app-b\":{\"environmentId\":\"b\",\"projectId\":\"app-b\"},\"lingxiloop-knowledge-agent\":{\"environmentId\":\"b\",\"projectId\":\"knowledge\"},\"uptime\":{\"environmentId\":\"b\",\"projectId\":\"uptime\"}}",
    "MCP_AUTH_USER_ID": "mcp-admin",
    "AUTH_ALLOWED_HOSTS": "loop.example.com,admin.example.com",
    "APP_VERSION": "test"
  }
}
